[TEMPLATE]
# Copy to .env.local and adjust. There is NO admin token here: the dashboard
# signs in with a Supabase Auth account (email + password) whose user id is
# listed in public.admin_users. ADMIN_TOKEN on the server is break-glass only
# (curl / tests / recovery), never used by this UI.
#
# Local harness (tests/serve_local.ts, default port):
NEXT_PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54431/functions/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key>
# Hosted:
# NEXT_PUBLIC_FUNCTIONS_URL=https://<your-project-ref>.supabase.co/functions/v1
# NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<project anon (public) key>
