# Copy to .env.local and adjust. NEVER put the admin token here — it is
# pasted into the login screen at runtime (kept in browser localStorage only).
#
# Local harness (tests/serve_local.ts, default port):
NEXT_PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54431/functions/v1
# Hosted:
# NEXT_PUBLIC_FUNCTIONS_URL=https://<your-project-ref>.supabase.co/functions/v1
